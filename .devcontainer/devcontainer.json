{
  "name": "thepaperobservatory.com",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "postCreateCommand": "npm ci",
  "forwardPorts": [5173],
  "portsAttributes": {
    "5173": { "label": "The Paper Observatory", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "settings": { "editor.formatOnSave": false }
    }
  }
}

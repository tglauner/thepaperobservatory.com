# The educational site needs no environment variables or credentials.
# Status notifications stay disabled unless explicitly requested.
STATUS_TELEGRAM_ENABLED=false

# Cloud publishing uses GitHub environment secrets, not browser variables.
# Set these through GitHub Settings > Environments > production:
# CLOUDFLARE_API_TOKEN (Cloudflare Pages Edit, limited to the chosen account)
# CLOUDFLARE_ACCOUNT_ID
# Enable the repository variable CLOUDFLARE_DEPLOY_ENABLED=true only after setup.
# Set OPENAI_API_KEY only in the paper-generation GitHub environment.
# Never export a ChatGPT/Codex auth.json into this public repository or CI.

# Optional public advertising settings; all ads are inactive by default.
# These IDs are public identifiers, never API keys. Certified CMP installation
# and the privacy notice must be reviewed before setting either flag true.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_PUBLISHER_ID=
VITE_ADSENSE_SLOT_ID=
VITE_GOOGLE_CMP_READY=false

# Public visitor analytics settings (build-time; never place secrets here).
ANALYTICS_ENABLED=true
ANALYTICS_APP_ID=paper-observatory
# Leave empty to choose local collector in dev, TGIR collector in production.
ANALYTICS_COLLECTOR_URL=
ANALYTICS_SCRIPT_URL=https://tglauner.com/visitor_analytics/tracking/tracking.js

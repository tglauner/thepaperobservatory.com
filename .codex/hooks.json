{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STATUS_TELEGRAM_ENABLED=false python3 status/status_slide.py hook-start",
            "timeout": 120,
            "statusMessage": "Opening working status slide"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "STATUS_TELEGRAM_ENABLED=false python3 status/status_slide.py hook-finish",
            "timeout": 120,
            "statusMessage": "Ensuring final status slide"
          }
        ]
      }
    ]
  }
}
